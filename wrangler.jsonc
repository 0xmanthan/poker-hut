{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poker-hut",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TABLES", "class_name": "TableRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableRoom"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "poker-hut", "database_id": "68614425-0237-48f0-9ea8-d845e9972b62", "migrations_dir": "migrations" }
  ]
}
